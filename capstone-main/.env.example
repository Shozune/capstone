# Required for Auth / DB. Names must start with VITE_ so the client can read them.
# Dashboard → Project Settings → API: copy "Project URL" and the "anon" "public" key.
# URL must be like https://xxxx.supabase.co — not .../rest/v1
#
# For signup confirmation emails: Supabase → Auth → URL Configuration → Redirect URLs must include
# http://localhost:5173/signin (dev) and your production /signin URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
